[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://UI/Screens/SetupScreen.cs" id="1_setup"]

[node name="SetupScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_setup")

[node name="CenterContainer" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBoxContainer" type="VBoxContainer" parent="CenterContainer"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="TitleLabel" type="Label" parent="CenterContainer/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 36
text = "Local Game Setup"
horizontal_alignment = 1

[node name="SceneTitleLabel" type="Label" parent="CenterContainer/VBoxContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(0.3, 0.9, 1, 1)
theme_override_font_sizes/font_size = 16
text = "Scene: Museum Mix-up"
horizontal_alignment = 1

[node name="DescriptionLabel" type="Label" parent="CenterContainer/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "Enter player names for this match:"
horizontal_alignment = 1

[node name="Player1Input" type="LineEdit" parent="CenterContainer/VBoxContainer"]
custom_minimum_size = Vector2(320, 40)
layout_mode = 2
placeholder_text = "Player 1 Name"
text = "Player 1"

[node name="Player2Input" type="LineEdit" parent="CenterContainer/VBoxContainer"]
custom_minimum_size = Vector2(320, 40)
layout_mode = 2
placeholder_text = "Player 2 Name"
text = "Player 2"

[node name="GameModeLabel" type="Label" parent="CenterContainer/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "Select Gameplay Mode:"

[node name="GameModeOption" type="OptionButton" parent="CenterContainer/VBoxContainer"]
custom_minimum_size = Vector2(320, 40)
layout_mode = 2

[node name="ErrorLabel" type="Label" parent="CenterContainer/VBoxContainer"]
visible = false
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.3, 0.3, 1)
theme_override_font_sizes/font_size = 14
horizontal_alignment = 1

[node name="StartRoundButton" type="Button" parent="CenterContainer/VBoxContainer"]
custom_minimum_size = Vector2(320, 44)
layout_mode = 2
text = "Start Recording Phase"

[node name="BackButton" type="Button" parent="CenterContainer/VBoxContainer"]
custom_minimum_size = Vector2(320, 40)
layout_mode = 2
text = "Back to Scene Selection"
